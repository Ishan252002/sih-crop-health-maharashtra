# The prototype runs entirely on the device. There is no server-side inference route, no
# vision provider and no API key: demo sample tiles use deterministic simulated inference,
# and a real uploaded photo is handled locally and routed to expert review.
#
# Do not reintroduce a paid inference provider here.

# Optional. Shows the "Demo mode: simulated inference" chip during the AI step.
NEXT_PUBLIC_DEMO_MODE=true

# Optional. CARTO raster basemaps require an API key; without it the gov dashboard
# map falls back to OpenStreetMap tiles. Unset is a supported, watermark-free state.
NEXT_PUBLIC_CARTO_KEY=
